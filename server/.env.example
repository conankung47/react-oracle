# ==========================================
# ตัวอย่างค่าการตั้งค่า Environment สำหรับ Server
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้เป็นของจริง
#   copy .env.example .env   (Windows CMD)
#   cp .env.example .env     (PowerShell / Git Bash)
# ==========================================

# ----- Database (Oracle) -----
DB_USER=your_oracle_user
DB_PASSWORD=your_oracle_password
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=XEPDB1

# ----- Server -----
PORT=5000
